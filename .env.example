# "What Did I Miss?" Local-First AI Micro-App Environment Variables

# Optional Supabase Integration (Only stores non-content: profile, settings, anonymous counter)
# Leave blank to run 100% in local guest mode using browser IndexedDB / localStorage!
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local AI Backend configuration (Ollama)
# By default, connects to Ollama running locally on port 11434
# If Ollama is offline or uninstalled, the app automatically fails over to the instant Rule-based NLP Engine!
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# App Server Port
PORT=3000
